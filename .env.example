# Copy this file to .env.local, fill it in, and never share or commit .env.local.

# ── Supabase (required) ── Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── AI (optional) ── NVIDIA free endpoint. Key from build.nvidia.com (starts with nvapi-)
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Thinking models answer faster and never come back empty with this off
AI_THINKING=off

# ── GIFs (optional) ── free key from developers.giphy.com
GIPHY_API_KEY=

# ── Voice huddles + screen share (optional) ── free Build plan at cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── GitHub link previews (optional) ── a read-only token raises the rate limit
GITHUB_TOKEN=

# ── Desktop notifications (optional) ── npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; Supabase's every-minute job sends it (see supabase/cron.sql)
CRON_SECRET=

# ── Google Drive sharing (optional) ── see DEPLOY.md step 7
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_APP_ID=

# ── Notion sharing (optional) ── see DEPLOY.md step 8
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Other options (switching AI provider, recap model, voice transcripts, site URL, hiding the Google button): see README.md
