# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect" → App frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects show an "anon" key instead; that works too:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: the public URL used in invite links (defaults to the browser's origin)
# NEXT_PUBLIC_SITE_URL=https://byte.yourdomain.com

# Server-only secret key (Project Settings → API → "secret" / "service_role").
# Needed for AI notes, recaps, @ai and voice transcripts. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Optional: turns on the GIF picker. Free key at https://developers.giphy.com
GIPHY_API_KEY=

# ── AI (optional) ──────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works; switching providers is just these values.
# Without them, sessions still work and recaps are built from goals + scores.
#
# NVIDIA (free for development/testing; production needs a paid plan):
# Pick any chat model on build.nvidia.com; its page shows the exact ID in the code sample
# (e.g. "publisher/model-name"). NVIDIA retires models over time, so check it's still listed.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=
#
# FreeLLMAPI (self-hosted router, for development):
# AI_BASE_URL=http://localhost:3001/v1
# AI_API_KEY=your-freellmapi-key
# AI_MODEL=auto
#
# OpenRouter / Groq (paid or free tiers, good for launch):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_BASE_URL=https://api.groq.com/openai/v1

# Optional: a stronger model just for end-of-session recaps
# AI_RECAP_MODEL=

# Optional: voice note transcripts (OpenAI-compatible /audio/transcriptions, e.g. Groq Whisper)
# AI_TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# AI_TRANSCRIBE_API_KEY=
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
