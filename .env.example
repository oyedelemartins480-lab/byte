# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect" → App frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects show an "anon" key instead; that works too:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: the public URL used in invite links (defaults to the browser's origin)
# NEXT_PUBLIC_SITE_URL=https://byte.yourdomain.com

# Optional: turns on the GIF picker. Free key at https://developers.giphy.com
GIPHY_API_KEY=
